# ============================================================================
# SS Brand Assets - Optimized Apache Configuration
# ============================================================================

# Force HTTPS (uncomment when SSL is ready)
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove www (or add www - choose one)
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ============================================================================
# Security Headers
# ============================================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options          "nosniff"
    Header always set X-Frame-Options                "DENY"
    Header always set X-XSS-Protection               "1; mode=block"
    Header always set Referrer-Policy                "strict-origin-when-cross-origin"
    Header always set Permissions-Policy             "geolocation=(), microphone=(), camera=()"
    Header always set Content-Security-Policy        "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'"
    
    # File-specific headers
    <FilesMatch "\.(svg|woff2?|ttf|eot)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
    <FilesMatch "\.svg$">
        Header set Content-Type "image/svg+xml"
    </FilesMatch>
</IfModule>

# ============================================================================
# Performance
# ============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg                      "access plus 1 year"
    ExpiresByType image/jpeg                     "access plus 1 year"
    ExpiresByType image/png                      "access plus 1 year"
    ExpiresByType image/svg+xml                  "access plus 1 year"
    ExpiresByType text/css                       "access plus 1 month"
    ExpiresByType application/javascript         "access plus 1 month"
    ExpiresByType font/woff2                     "access plus 1 year"
</IfModule>

FileETag None

# ============================================================================
# URL Rewriting & Clean URL Masking
# ============================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect directories to trailing slashes
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(.+[^/])$ $1/ [R=301,L]

    # 1. External redirect: Strip .html extension if typed directly by user
    # e.g. /pages/brand-system.html -> /pages/brand-system
    RewriteCond %{THE_REQUEST} \s/pages/([^\s\?]+)\.html[\s\?] [NC]
    RewriteRule ^pages/([^\s]+)\.html$ /pages/%1 [R=301,L]

    # 2. Short Root-level URL Masking:
    # e.g. /brand-system -> pages/brand-system.html
    # e.g. /components -> pages/components.html
    # e.g. /tools -> pages/tools.html
    RewriteCond %{DOCUMENT_ROOT}/pages/$1.html -f
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ pages/$1.html [L,QSA]

    # 3. /pages/ Extensionless URL Masking:
    # e.g. /pages/brand-system -> pages/brand-system.html
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [L,QSA]

    # 4. Short doc & section aliases:
    RewriteRule ^doc-([a-zA-Z0-9_-]+)/?$      pages/doc.html?doc=$1 [QSA,L]
    RewriteRule ^pages/doc-([a-zA-Z0-9_-]+)/?$ pages/doc.html?doc=$1 [QSA,L]
    RewriteRule ^roadmap/?$                    pages/doc.html?doc=roadmap [QSA,L]
    RewriteRule ^changelog/?$                  pages/doc.html?doc=changelog [QSA,L]
    RewriteRule ^brand/?$                      pages/brand-system.html [QSA,L]
    RewriteRule ^guidelines/?$                 pages/brand-guidelines.html [QSA,L]
    RewriteRule ^colors/?$                     pages/brand-system.html#colour [R=301,NE,L]
    RewriteRule ^typography/?$                 pages/brand-system.html#typography [R=301,NE,L]
    RewriteRule ^logos/?$                      pages/brand-system.html#logomark [R=301,NE,L]
    RewriteRule ^download/?$                   pages/brand-system.html#download [R=301,NE,L]
</IfModule>

# ============================================================================
# Access Control
# ============================================================================
<Files ".htaccess">
    Require all denied
</Files>

<FilesMatch "\.(log|env)$">
    Require all denied
</FilesMatch>

# Password-protect a directory (uncomment if needed)
# <Directory "/var/www/html/brand-guidelines">
#     AuthType Basic
#     AuthName "Restricted"
#     AuthUserFile "/var/www/html/.htpasswd"
#     Require valid-user
# </Directory>

# ============================================================================
# Error Handling
# ============================================================================
ErrorDocument 403 /pages/403.html
ErrorDocument 404 /pages/404.html
ErrorDocument 500 /pages/500.html

# ============================================================================
# Maintenance Mode (uncomment when needed)
# ============================================================================
# RewriteCond %{REMOTE_ADDR} !^127\.0\.0\.1$
# RewriteCond %{REMOTE_ADDR} !^::1$
# RewriteRule ^ /maintenance.html [R=503,L]
# ErrorDocument 503 /maintenance.html