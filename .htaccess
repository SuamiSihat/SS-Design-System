# ============================================================================
# SS Brand Assets - Optimized Apache Configuration
# ============================================================================

# ============================================================================
# Security Headers
# ============================================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options          "nosniff"
    Header always set X-Frame-Options                "DENY"
    Header always set X-XSS-Protection               "1; mode=block"
    Header always set Referrer-Policy                "strict-origin-when-cross-origin"
    Header always set Permissions-Policy             "geolocation=(), microphone=(), camera=()"
    Header always set Content-Security-Policy        "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://code.iconify.design; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.iconify.design https://api.simplesvg.com https://api.unisvg.com"
    
    # File-specific headers
    <FilesMatch "\.(svg|woff2?|ttf|eot)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
    <FilesMatch "\.svg$">
        Header set Content-Type "image/svg+xml"
    </FilesMatch>
</IfModule>

# ============================================================================
# Performance
# ============================================================================
<IfModule mod_deflate.c>
    # Compress text-based assets
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/x-font-ttf font/woff font/woff2

    # Compression level (1=fast, 9=best) — 6 is a good balance
    DeflateCompressionLevel 6

    # Don't compress if already compressed
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|gz|zip|bz2|rar)$ no-gzip dont-vary
</IfModule>

# Brotli compression (Synology DSM 7+ / Apache 2.4.26+)
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg                      "access plus 1 year"
    ExpiresByType image/jpeg                     "access plus 1 year"
    ExpiresByType image/png                      "access plus 1 year"
    ExpiresByType image/webp                     "access plus 1 year"
    ExpiresByType image/svg+xml                  "access plus 1 year"
    ExpiresByType text/css                       "access plus 1 month"
    ExpiresByType application/javascript         "access plus 1 month"
    ExpiresByType font/woff                      "access plus 1 year"
    ExpiresByType font/woff2                     "access plus 1 year"
    ExpiresByType application/font-woff2         "access plus 1 year"
</IfModule>

# PERF-01: Long-cache headers for CI-minified dist/ assets (fingerprinted via ?v= in HTML)
<IfModule mod_headers.c>
    <FilesMatch "^(assets/css/dist|assets/js/dist)/">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

FileETag None

# ============================================================================
# Clean URL Rewriting & Extensionless Navigation
# ============================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect directories to trailing slashes
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(.+[^/])$ $1/ [R=301,L]

    # 1. External 301 Redirect: Strip .html extension if requested directly in browser URL
    # e.g. /pages/brand-guidelines.html -> /pages/brand-guidelines
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s\?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # 2. Internal Rewrite: /pages/name -> /pages/name.html
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(pages/[a-zA-Z0-9_-]+)/?$ $1.html [L,QSA]

    # 3. Internal Rewrite: /name -> /pages/name.html (Root short URL alias)
    RewriteCond %{DOCUMENT_ROOT}/pages/$1.html -f
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ pages/$1.html [L,QSA]

    # 4. Fallback internal rewrite for any extensionless request
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [L,QSA]

    # 5. Short aliases & doc query shortcuts
    RewriteRule ^doc-([a-zA-Z0-9_-]+)/?$       pages/doc.html?doc=$1 [QSA,L]
    RewriteRule ^pages/doc-([a-zA-Z0-9_-]+)/?$  pages/doc.html?doc=$1 [QSA,L]
    RewriteRule ^roadmap/?$                     pages/doc.html?doc=roadmap [QSA,L]
    RewriteRule ^changelog/?$                   pages/doc.html?doc=changelog [QSA,L]
    RewriteRule ^brand/?$                       pages/brand-system.html [QSA,L]
    RewriteRule ^guidelines/?$                  pages/brand-guidelines.html [QSA,L]
    RewriteRule ^colors/?$                      pages/brand-system.html#colour [R=301,NE,L]
    RewriteRule ^typography/?$                  pages/brand-system.html#typography [R=301,NE,L]
    RewriteRule ^logos/?$                       pages/brand-system.html#logomark [R=301,NE,L]
    RewriteRule ^download/?$                    pages/brand-system.html#download [R=301,NE,L]
</IfModule>

# ============================================================================
# Access Control
# ============================================================================
<Files ".htaccess">
    Require all denied
</Files>

<FilesMatch "\.(log|env)$">
    Require all denied
</FilesMatch>

# Password-protect a directory (uncomment if needed)
# <Directory "/var/www/html/brand-guidelines">
#     AuthType Basic
#     AuthName "Restricted"
#     AuthUserFile "/var/www/html/.htpasswd"
#     Require valid-user
# </Directory>

# ============================================================================
# Error Handling
# ============================================================================
ErrorDocument 403 /pages/403.html
ErrorDocument 404 /pages/404.html
ErrorDocument 500 /pages/500.html

# ============================================================================
# Maintenance Mode (uncomment when needed)
# ============================================================================
# RewriteCond %{REMOTE_ADDR} !^127\.0\.0\.1$
# RewriteCond %{REMOTE_ADDR} !^::1$
# RewriteRule ^ /maintenance.html [R=503,L]
# ErrorDocument 503 /maintenance.html